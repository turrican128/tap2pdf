# Real game tapes never enter this repo. They are copyrighted, and a public
# GitHub repo is not an archive. Synthetic test fixtures live in
# tests/fixtures/ and are explicitly re-included below.
*.tap
*.t64
*.d64
*.prg
!tests/fixtures/*.tap
!tests/fixtures/*.prg
!examples/*.tap

# QA sweep results reference local tapes by name; they stay local too.
qa-baseline*.json
qa-*.json

__pycache__/
*.pyc
.pytest_cache/
build/
dist/
*.spec
